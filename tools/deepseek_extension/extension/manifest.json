{
  "manifest_version": 3,
  "name": "Brain Mapper - DeepSeek Annotator",
  "version": "1.0.0",
  "description": "Isolated automation bridge for cognitive skill annotation on DeepSeek Chat.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://chat.deepseek.com/*",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Brain Mapper Annotator"
  },
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": [
        "content/deepseek_dom.js",
        "content/parser.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
